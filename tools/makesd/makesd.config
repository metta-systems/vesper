// The SD card image (`just sdimage` in tools/makesd): a FAT boot partition
// holding everything under boot/, at offset 1 MiB in an MBR disk image.
// Images are built in the order they are listed; a disk takes its partitions'
// images from the output directory.

fat "boot.vfat" {
    label "BOOT"
    size "128M"
    fat-type 32 // FAT32, for the partition type 0x0c: would be FAT16 by default.
}

disk "sdcard.img" {
    partition "boot" {
        image "boot.vfat"
        type 0x0c
        offset "1M"
        bootable #true
    }
}
