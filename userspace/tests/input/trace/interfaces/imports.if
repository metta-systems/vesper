#
# The USB HID component's input interface: the program reads the descriptor and
# the state of each device it serves, and its events arrive on the interface's
# io-channel.
uses input_v1 via component usb_hid { descriptor, snapshot, trace }
# The USB core's trace, which the program prints for it like the HID component's:
# neither has a serial channel of its own here.
uses usb_v1 via component usb_core { trace }
