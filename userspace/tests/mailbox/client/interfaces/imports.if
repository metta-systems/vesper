#
# The client has no device tree node, so every chain starts from a node found
# by its compatible string: the firmware node, which links to the mailbox,
# the power management node and the framebuffer node. The client may power
# devices off, but not halt or reset the board.
uses mailbox_v1 via compatible "raspberrypi,bcm2835-firmware", mboxes {
    get_board_revision, get_board_serial, get_clock_rate, get_power_state, set_led, property
}
uses power_v1 via compatible "brcm,bcm2835-pm" { devices_off }
uses fb_v1 via compatible "brcm,bcm2708-fb" { configure, address, size, pixel_order, frames }
