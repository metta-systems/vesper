## The host controller of a USB bus (Raspberry Pi 3's `DesignWare` DWC2 in host
## mode). The controller schedules every transfer: a client opens a pipe to one
## endpoint and transfers through it (`pipe_v1`). Nothing here is DWC2-specific,
## so a later xHCI controller can serve the same interface. Prototype: edited
## in place.
local interface usb_hcd_v1
{
    ## The area the client stages control transfers in (see `pipe_v1`), and where
    ## `open_pipe` returns the keys it installs.
    data 4096;

    ## Every function receives the badge of the key it was called through: the
    ## controller knows its caller from the key.
    badged;

    ## The io-channel interrupt-IN reports travel on: a control page and one data
    ## page, shared by each client and the controller. It runs in receive mode
    ## (`vesper_usb_protocol::report_channel`): the client posts empty buffers of
    ## the data page and waits on the channel's `EventCount`; the controller
    ## returns each buffer with the report of one poll, its length cut to the
    ## report and its value the pipe's handle. Pipes of the client are polled
    ## only while a buffer waits.
    channel 1;

    ## The slots of the controller's table that hold the key a client lends.
    placement 1;

    ## The speed a device runs at; a low- or full-speed device behind a
    ## high-speed hub needs split transactions (see `pipe_v1.set_route`).
    enum speed { low, full, high }

    ## No device is attached to the port.
    exception no_device {}

    ## The controller is busy with a reset or another exclusive operation, or has
    ## no pipe left.
    exception busy {}

    ## The request is not allowed: an argument or a destination slot is not usable.
    exception not_permitted {}

    ## Reset the root port `port` for the device attached to it, and return the
    ## speed the device runs at. Reset takes its mandated recovery time.
    reset_port(card32 port)
        returns (speed speed)
        raises (no_device, busy);

    ## The status bits of the root port `port`: bit 0 connected, bit 1 enabled,
    ## bit 16 connect changed, bit 17 enable changed (a reset enabled the port).
    ## A port that does not exist reports no bits.
    port_status(card32 port)
        returns (card32 bits);

    ## Open a pipe to endpoint `endpoint` of device `device_address`. `endpoint`
    ## is the endpoint address of the USB specification: the number in bits 0 to
    ## 3 and, for an endpoint that moves data to the host, bit 7. The pipe is
    ## the keys of `pipe_v1`, one per function in declaration order, that the
    ## controller installs in the lent table `into`, at `first_slot` and the
    ## slots after it, all badged with the pipe. Their wire keys are written to
    ## the data area as 64-bit values from offset 0, because a slot's
    ## incarnation is not predictable. The slots must be vacant, else the call
    ## raises `not_permitted`. The keys belong to whoever holds them. A new pipe
    ## carries no transfer until `pipe_v1.configure` says what it transfers.
    open_pipe(card32 first_slot, card32 device_address, card32 endpoint, speed speed)
        lends (key_table into)
        installs (pipe_v1)
        raises (busy, not_permitted);
}
