#
# The card clock divides the core clock, whose rate the firmware reports
# through the mailbox, found by the firmware node's compatible string.
uses mailbox_v1 via device compatible "raspberrypi,bcm2835-firmware", mboxes { get_clock_rate }
# The pins of the node's pin group (`pinctrl-0`) get their pulls and are
# routed to the controller at start.
uses gpio_v1 via device compatible "brcm,bcm2835-gpio" { set_function, set_pull }
