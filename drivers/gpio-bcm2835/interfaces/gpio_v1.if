## The GPIO pins of the BCM2835 and BCM2711 (Raspberry Pi 1 to 4), served by
## the gpio component, the one owner of the GPIO block.
##
## A client drives the pins it owns only: Kickstart badges each client's key
## with the pins its device tree node names (its default pin state, its
## `<name>-gpios` and `gpios` specifiers, the `gpios` of its `backlight`), and
## every function refuses a pin outside that set.
local interface gpio_v1
{
    ## Every function receives the client's pin set as its badge.
    badged by pins;

    ## What a pin is connected to: a general input or output, or one of the
    ## six alternate functions of the pin (see the BCM2835 ARM Peripherals
    ## manual, section 6.2, for what each pin's alternates are).
    enum pin_function {
        input, output, alt0, alt1, alt2, alt3, alt4, alt5
    }

    ## The resistor that holds a pin's level while nothing drives it.
    enum pin_pull {
        off, down, up
    }

    ## The block has no pin `pin`.
    exception invalid_pin { card32 pin; }

    ## The caller's node does not name `pin`.
    exception not_owned { card32 pin; }

    ## Connect `pin` to `function`.
    set_function(card32 pin, pin_function function)
        raises (invalid_pin, not_owned);

    ## Pull `pin` up or down, or neither. A pin keeps its pull when its
    ## function changes.
    set_pull(card32 pin, pin_pull pull)
        raises (invalid_pin, not_owned);

    ## Drive `pin` high or low while it is an output (`GPSETn` or `GPCLRn`).
    ## While it is an input the level is ignored, and the pin takes the last
    ## one set once it is an output (BCM2711 ARM Peripherals, section 5.2).
    set_level(card32 pin, boolean high)
        raises (invalid_pin, not_owned);
}
